#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
import json
import numpy as np
import torch
import torch.nn as nn
import rasterio
from tqdm import tqdm
from rasterio.features import geometry_mask
import geopandas as gpd
import matplotlib.pyplot as plt

# === Model definition ===
class SFModel(nn.Module):
    def __init__(self, in_ch=2, hid=64):
        super().__init__()
        self.conv1 = nn.Conv1d(in_ch, 32, kernel_size=3, padding=1)
        self.relu  = nn.ReLU()
        self.lstm  = nn.LSTM(32, hid, num_layers=1, batch_first=True)
        self.tr    = nn.TransformerEncoder(
            nn.TransformerEncoderLayer(d_model=hid, nhead=4, batch_first=True),
            num_layers=2)
        self.out   = nn.Linear(hid, 1)

    def forward(self, x, mask):
        x = x.permute(0, 2, 1)
        x = self.relu(self.conv1(x))
        x = x.permute(0, 2, 1)
        x, _ = self.lstm(x)
        x = self.tr(x, src_key_padding_mask=~mask)
        return self.out(x).squeeze(-1)

# === Configuration ===
data_dir  = r"..."
model_fp  = os.path.join(data_dir, "crf_model.pth")
out_dir   = os.path.join(data_dir, "crf_predicted_ndvi")
ref_tif   = r"..."
shp_path  = r"..."

os.makedirs(out_dir, exist_ok=True)
os.makedirs(os.path.join(out_dir, "compare"), exist_ok=True)

# === Load data ===
s1       = np.load(os.path.join(data_dir, "S1_stack_vv_vh.npy"))  # (T,H,W,2)
s2_mask  = np.load(os.path.join(data_dir, "S2_cloudmask.npy"))    # (T,H,W)
with open(os.path.join(data_dir, "dates.json")) as f:
    dates = json.load(f)
T, H, W, C = s1.shape

X = s1.transpose(1, 2, 0, 3).reshape(-1, T, C)
M = (s2_mask.transpose(1, 2, 0) == 0).reshape(-1, T)  # (H*W,T)

# === Load reference GeoTIFF and ROI mask ===
with rasterio.open(ref_tif) as ref:
    profile = ref.profile.copy()
    transform = ref.transform
    crs = ref.crs
    profile.update(count=1, dtype="float32", compress="lzw", nodata=np.nan)

# ROI mask
gdf = gpd.read_file(shp_path)
if gdf.crs != crs:
    gdf = gdf.to_crs(crs)
roi_mask = geometry_mask(gdf.geometry, invert=True, transform=transform, out_shape=(H, W))

# === Load model ===
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
model = SFModel().to(device)
model.load_state_dict(torch.load(model_fp, map_location=device))
model.eval()

# === Batch prediction ===
with torch.no_grad():
    preds = []
    B = 2048
    for i in tqdm(range(0, len(X), B), desc="Predicting NDVI"):
        xb = torch.from_numpy(X[i:i+B]).float().to(device)
        mb = torch.from_numpy(M[i:i+B]).bool().to(device)
        pr = model(xb, mb).cpu().numpy()
        preds.append(pr)

Y_hat = np.concatenate(preds, axis=0).reshape(H, W, T).transpose(2, 0, 1)  # (T,H,W)

# === Output GeoTIFFs and visualizations ===
for ti, date in enumerate(dates):
    pred = Y_hat[ti]                   # (H,W)
    mask = roi_mask
    pred_masked = np.where(mask, pred, np.nan)

    out_fp = os.path.join(out_dir, f"NDVI_Predict_{date}.tif")
    with rasterio.open(out_fp, "w", **profile) as dst:
        dst.write(pred_masked.astype(np.float32), 1)

    # Visualization (predicted NDVI)
    fig, ax = plt.subplots(figsize=(6, 6))
    im = ax.imshow(pred_masked, cmap="YlGn", vmin=-1, vmax=1)
    ax.set_title(f"Predicted NDVI - {date}")
    ax.axis("off")
    fig.colorbar(im, ax=ax, label="NDVI")
    fig.savefig(os.path.join(out_dir, "compare", f"compare_{date}.png"), dpi=200)
    plt.close(fig)

print("\n✅ All NDVI prediction GeoTIFFs and comparison plots saved to:", out_dir)

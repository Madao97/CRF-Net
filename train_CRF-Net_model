# train_model.py

import os
import json
import numpy as np
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from tqdm import tqdm
import csv
from sklearn.metrics import r2_score
from torch.amp import autocast, GradScaler

# === Model ===
class SFModel(nn.Module):
    def __init__(self, in_ch=2, hid=64):
        super().__init__()
        self.conv1 = nn.Conv1d(in_ch, 32, kernel_size=3, padding=1)
        self.relu  = nn.ReLU()
        self.lstm  = nn.LSTM(32, hid, num_layers=1, batch_first=True)
        self.tr    = nn.TransformerEncoder(
            nn.TransformerEncoderLayer(d_model=hid, nhead=4, batch_first=True),
            num_layers=2)
        self.out   = nn.Linear(hid, 1)

    def forward(self, x, mask):
        x = x.permute(0, 2, 1)           # (B,C,T)
        x = self.relu(self.conv1(x))     # (B,32,T)
        x = x.permute(0, 2, 1)           # (B,T,32)
        x, _ = self.lstm(x)              # (B,T,H)
        # Transformer with cloud mask
        x = self.tr(x, src_key_padding_mask=~mask)
        return self.out(x).squeeze(-1)   # (B,T)

# === MAIN ===
def main():
    # === Configuration ===
    data_dir = r"..."
    out_model  = os.path.join(data_dir, "crf_model.pth")
    out_csv    = os.path.join(data_dir, "crf_model_training_history.csv")
    batch_size = 64
    num_epochs = 25
    lr         = 1e-3
    early_stop = 5

    # === Load data ===
    s1 = np.load(os.path.join(data_dir, "S1_stack_vv_vh.npy"))      # (T,H,W,2)
    s2 = np.load(os.path.join(data_dir, "S2_ndvi_masked.npy"))      # (T,H,W)
    cm = np.load(os.path.join(data_dir, "S2_cloudmask.npy"))        # (T,H,W)
    with open(os.path.join(data_dir, "dates.json")) as f:
        dates = json.load(f)

    T, H, W, C = *s1.shape[:3], s1.shape[3]
    s1 = s1.transpose(1, 2, 0, 3).reshape(-1, T, C)  # (H*W, T, 2)
    s2 = s2.transpose(1, 2, 0).reshape(-1, T)       # (H*W, T)
    cm = cm.transpose(1, 2, 0).reshape(-1, T) == 0  # (H*W, T) cloud==0 is valid

    valid = cm.sum(axis=1) > 0                      # At least one valid timestep
    s1 = s1[valid]
    s2 = s2[valid]
    cm = cm[valid]
    print(f"✅ Loaded valid training pixels: {len(s1):,}")

    # === Dataset ===
    class NDVIDataset(Dataset):
        def __init__(self, x, y, m):
            self.x, self.y, self.m = x, y, m
        def __len__(self):
            return len(self.x)
        def __getitem__(self, i):
            return self.x[i], self.y[i], self.m[i]

    dset = NDVIDataset(torch.from_numpy(s1).float(),
                       torch.from_numpy(s2).float(),
                       torch.from_numpy(cm).bool())

    dloader = DataLoader(dset, batch_size=batch_size, shuffle=True, num_workers=0)

    # === Training ===
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model = SFModel().to(device)
    opt   = torch.optim.Adam(model.parameters(), lr=lr)
    loss_fn = nn.MSELoss(reduction="none")
    scaler = GradScaler()

    print("\n🚀 Training CRF model...")
    with open(out_csv, "w", newline="") as f:
        writer = csv.writer(f)
        writer.writerow(["epoch", "r2", "rmse"])

        best_r2 = -1
        bad_epochs = 0

        for ep in range(1, num_epochs + 1):
            model.train()
            all_pred, all_true, all_mask = [], [], []

            for xb, yb, mb in tqdm(dloader, desc=f"Epoch {ep:02d}"):
                xb, yb, mb = xb.to(device), yb.to(device), mb.to(device)
                with autocast(device_type=device.type):
                    pr = model(xb, mb)
                    loss = (loss_fn(pr, yb) * mb.float()).sum() / mb.float().sum().clamp(min=1)
                opt.zero_grad()
                scaler.scale(loss).backward()
                scaler.step(opt)
                scaler.update()
                all_pred.append(pr.detach().cpu().numpy())
                all_true.append(yb.detach().cpu().numpy())
                all_mask.append(mb.detach().cpu().numpy())

            yt = np.concatenate([y[m] for y, m in zip(all_true, all_mask)])
            yp = np.concatenate([p[m] for p, m in zip(all_pred, all_mask)])

            valid_idx = (~np.isnan(yt)) & (~np.isnan(yp))
            yt, yp = yt[valid_idx], yp[valid_idx]

            r2 = r2_score(yt, yp)
            rmse = float(np.sqrt(((yt - yp) ** 2).mean()))

            print(f"  🔁 Epoch {ep:02d}: R² = {r2:.4f}  RMSE = {rmse:.4f}")
            writer.writerow([ep, f"{r2:.4f}", f"{rmse:.4f}"])
            f.flush()

            if r2 > best_r2:
                best_r2 = r2
                bad_epochs = 0
                torch.save(model.state_dict(), out_model)
                print("  ✅ Model improved and saved.")
            else:
                bad_epochs += 1
                if bad_epochs >= early_stop:
                    print("  🛑 Early stopping triggered.")
                    break

    print("\n✅ Best model saved to:", out_model)
    print("📄 Training history saved to:", out_csv)

if __name__ == "__main__":
    import multiprocessing
    multiprocessing.freeze_support()
    main()

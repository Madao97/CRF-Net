#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
generate_val_coords.py

- Extract cloud-free regions from S2_ndvi_masked.npy (cloud == 0 and non-NaN)
- Perform 10-bin NDVI stratified reservoir sampling
"""

import os
import numpy as np
from tqdm import tqdm  # ✅ progress bar

# Path configuration
data_dir = r"..."
val_dir = os.path.join(data_dir, "Validation_set")
os.makedirs(val_dir, exist_ok=True)

# Parameters
samples_per_bin = 250_000
bin_edges = np.linspace(-1, 1, 11)
rng = np.random.default_rng(42)

# Load data
ndvi = np.load(os.path.join(data_dir, "S2_ndvi_masked.npy"))     # (T,H,W)
cloud = np.load(os.path.join(data_dir, "S2_cloudmask.npy"))      # (T,H,W)
T, H, W = ndvi.shape

bins = {i: [] for i in range(10)}
counts = {i: 0 for i in range(10)}

# ✅ Iterate over time frames to sample clear NDVI regions (with progress bar)
for t in tqdm(range(T), desc="Building val_coords"):
    mask = (cloud[t] == 0) & (~np.isnan(ndvi[t]))
    rows, cols = np.where(mask)
    vals = ndvi[t][rows, cols]
    segs = np.digitize(vals, bin_edges) - 1
    segs = np.clip(segs, 0, 9)

    for r, c, b in zip(rows, cols, segs):
        coord = (t, int(r), int(c))
        counts[b] += 1
        if len(bins[b]) < samples_per_bin:
            bins[b].append(coord)
        else:
            j = rng.integers(0, counts[b])
            if j < samples_per_bin:
                bins[b][j] = coord

# Merge and save
val_coords = []
for b in range(10):
    val_coords.extend(bins[b])
rng.shuffle(val_coords)
val_coords_np = np.array(val_coords, dtype=np.int32)

np.save(os.path.join(val_dir, "val_coords.npy"), val_coords_np)

print(f"✅ Validation set generated, total samples: {len(val_coords_np):,}")
print(f"Saved to: {os.path.join(val_dir, 'val_coords.npy')}")
